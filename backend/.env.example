# Application Settings
PROJECT_NAME=AdsGenie API
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_STR=/api/v1

# Database
DATABASE_URL=sqlite:///./adsgenie.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/adsgenie

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
