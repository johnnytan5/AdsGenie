{
	"info": {
		"_postman_id": "adsgenie-audio-api",
		"name": "AdsGenie Audio API",
		"description": "Postman collection for testing AdsGenie Audio API endpoints (Music & Text-to-Speech)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Setup",
			"item": [
				{
					"name": "1. Create Project",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set(\"project_id\", response.project_id);",
									"    console.log(\"Project ID saved:\", response.project_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Audio Test Project\",\n    \"aspect_ratio\": \"16:9\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/projects",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"projects"
							]
						},
						"description": "Create a new project for testing audio endpoints"
					},
					"response": []
				},
				{
					"name": "2. Create Scene",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set(\"scene_id\", response.scene_id);",
									"    console.log(\"Scene ID saved:\", response.scene_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"A person crying in a dark room\",\n    \"duration\": 10\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/projects/{{project_id}}/scenes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"projects",
								"{{project_id}}",
								"scenes"
							]
						},
						"description": "Create a scene for testing audio generation"
					},
					"response": []
				},
				{
					"name": "3. Get Project (Verify Setup)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/projects/{{project_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"projects",
								"{{project_id}}"
							]
						},
						"description": "Verify project and scene were created successfully"
					},
					"response": []
				}
			],
			"description": "Setup requests to create project and scene"
		},
